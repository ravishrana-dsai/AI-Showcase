{
  "name": "slack-agentic-bot",
  "version": "1.0.0",
  "description": "Constant-running Slack bot that stores messages as tasks, content, and structured notes",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/app.js",
    "dev": "ts-node src/app.ts",
    "db:migrate": "psql $DATABASE_URL -f src/db/schema.sql"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@slack/bolt": "^3.17.0",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  }
}
