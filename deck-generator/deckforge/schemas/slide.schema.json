{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeckForge Slide Deck",
  "type": "object",
  "required": ["deck"],
  "properties": {
    "deck": {
      "type": "object",
      "required": ["title", "client", "slides"],
      "properties": {
        "title": { "type": "string" },
        "client": { "type": "string" },
        "slides": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "object",
            "required": ["id", "type", "heading"],
            "properties": {
              "id": { "type": "number" },
              "type": {
                "type": "string",
                "enum": ["title", "two-col", "bullets", "quote", "stats", "process", "comparison"]
              },
              "heading": { "type": "string" },
              "subheading": { "type": "string" },
              "logo": { "type": "boolean" },
              "left": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["bullets", "image", "text"] },
                  "items": { "type": "array", "items": { "type": "string" } },
                  "src": { "type": "string" }
                }
              },
              "right": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "enum": ["bullets", "image", "text"] },
                  "items": { "type": "array", "items": { "type": "string" } },
                  "src": { "type": "string" }
                }
              },
              "bullets": {
                "type": "array",
                "items": { "type": "string" }
              },
              "quote": { "type": "string" },
              "attribution": { "type": "string" },
              "stats": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": ["value", "label"],
                  "properties": {
                    "value": { "type": "string" },
                    "label": { "type": "string" },
                    "delta": { "type": "string" }
                  }
                }
              },
              "steps": {
                "type": "array",
                "minItems": 2,
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "required": ["title"],
                  "properties": {
                    "title": { "type": "string" },
                    "description": { "type": "string" }
                  }
                }
              },
              "leftLabel": { "type": "string" },
              "rightLabel": { "type": "string" },
              "rows": {
                "type": "array",
                "minItems": 2,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": ["label", "left", "right"],
                  "properties": {
                    "label": { "type": "string" },
                    "left": { "type": "string" },
                    "right": { "type": "string" },
                    "winner": { "type": "string", "enum": ["left", "right", "tie"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
