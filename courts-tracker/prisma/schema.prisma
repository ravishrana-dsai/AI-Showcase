generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum CourtStatus {
  ACTIVE
  INACTIVE
  ONBOARDING
  SUSPENDED
}

enum RequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum StageLogStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  SKIPPED
}

enum AlertType {
  SLA_WARNING
  SLA_BREACH
  ERROR
  MANUAL_FLAG
}

enum UserRole {
  ADMIN
  OPS
  LEADERSHIP
}

// ─── Courts ──────────────────────────────────────────────────────────────────

model Court {
  id             String      @id @default(cuid())
  externalId     String?     @unique @map("external_id")
  name           String
  city           String
  state          String?
  country        String      @default("India")
  address        String?
  partnerName    String?     @map("partner_name")
  partnerContact String?     @map("partner_contact")
  partnerEmail   String?     @map("partner_email")
  surfaceType    String?     @map("surface_type")
  totalCourts    Int         @default(1) @map("total_courts")
  status         CourtStatus @default(ACTIVE)
  metadata       Json?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  requests Request[]

  @@map("courts")
}

// ─── Pipeline Stages (admin-configurable) ────────────────────────────────────

model PipelineStage {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  stageOrder  Int      @map("stage_order")
  slaHours    Decimal  @default(24) @map("sla_hours") @db.Decimal(5, 2)
  isActive    Boolean  @default(true) @map("is_active")
  color       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stageLogs RequestStageLog[]
  slaAlerts SlaAlert[]

  @@map("pipeline_stages")
}

// ─── Requests ─────────────────────────────────────────────────────────────────

model Request {
  id             String        @id @default(cuid())
  externalId     String?       @unique @map("external_id")
  courtId        String        @map("court_id")
  court          Court         @relation(fields: [courtId], references: [id])

  playerId       String?       @map("player_id")
  playerName     String?       @map("player_name")
  matchDate      DateTime?     @map("match_date")

  videoUrl       String?       @map("video_url")
  videoDuration  Int?          @map("video_duration")
  videoSizeBytes BigInt?       @map("video_size_bytes")
  videoMetadata  Json?         @map("video_metadata")

  currentStageId String?       @map("current_stage_id")
  status         RequestStatus @default(PENDING)
  slaBreached    Boolean       @default(false) @map("sla_breached")

  errorLogs      Json?         @map("error_logs")
  lastError      String?       @map("last_error")

  notes          String?
  assignedTo     String?       @map("assigned_to")
  flags          Json?

  completedAt    DateTime?     @map("completed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  stageLogs  RequestStageLog[]
  slaAlerts  SlaAlert[]

  @@index([courtId])
  @@index([status])
  @@index([slaBreached])
  @@index([createdAt])
  @@map("requests")
}

// ─── Stage Logs ───────────────────────────────────────────────────────────────

model RequestStageLog {
  id           String         @id @default(cuid())
  requestId    String         @map("request_id")
  request      Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stageId      String         @map("stage_id")
  stage        PipelineStage  @relation(fields: [stageId], references: [id])

  startedAt    DateTime?      @map("started_at")
  completedAt  DateTime?      @map("completed_at")
  durationMin  Decimal?       @map("duration_min") @db.Decimal(10, 2)
  status       StageLogStatus @default(PENDING)
  errorMessage String?        @map("error_message")
  metadata     Json?
  updatedBy    String?        @map("updated_by")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([requestId])
  @@index([stageId])
  @@map("request_stage_logs")
}

// ─── SLA Alerts ───────────────────────────────────────────────────────────────

model SlaAlert {
  id             String        @id @default(cuid())
  requestId      String        @map("request_id")
  request        Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stageId        String        @map("stage_id")
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  alertType      AlertType     @map("alert_type")
  message        String?
  acknowledged   Boolean       @default(false)
  acknowledgedBy String?       @map("acknowledged_by")
  acknowledgedAt DateTime?     @map("acknowledged_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([requestId])
  @@index([acknowledged])
  @@map("sla_alerts")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  image     String?
  role      UserRole @default(OPS)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

// ─── NextAuth ─────────────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
